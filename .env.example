# Salin file ini menjadi .env lalu isi nilainya.
# JANGAN commit file .env ke repository.

# --- Chat (Groq) -----------------------------------------------------------
# Wajib: API key Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Opsional: endpoint OpenAI-compatible milik Groq
GROQ_BASE_URL=

# Opsional: model chat utama
GROQ_MODEL=

# Opsional: model ringan untuk membuat judul percakapan
GROQ_TITLE_MODEL=

# --- RAG (Gemini embedding + Qdrant) ---------------------------------------
# Wajib untuk RAG: API key Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opsional: model embedding, default gemini-embedding-001
GEMINI_EMBED_MODEL=

# Opsional: dimensi vector yang diminta ke API, default 768
GEMINI_EMBED_DIM=

# Opsional: folder penyimpanan Qdrant local mode, default data/qdrant
QDRANT_PATH=

# Opsional: nama collection Qdrant, default documents
QDRANT_COLLECTION=

# --- Penyimpanan -----------------------------------------------------------
# Opsional: lokasi file database SQLite
APP_DB_PATH=
